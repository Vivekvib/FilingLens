# Copy this file to .env and fill in real values. Never commit the real .env.

# Get a free key at https://console.groq.com — no credit card required.
# Sign up with email or Google, then create a key under API Keys.
GROQ_API_KEY=

# SEC requires a descriptive User-Agent with contact info on every request,
# or it will reject/rate-limit you. Format: "AppName (your-email@example.com)"
SEC_USER_AGENT=FilingLens Student Project (replace-with-your-email@example.com)
